#!/usr/bin/env bash
# hermes-project — auto-select a Hermes profile from the launch folder.
#
# Mapping: git toplevel of cwd (or cwd itself when not in a repo) ->
# "<sanitized basename>-<8-hex hash of the physical path>" -> profile name.
# The path hash makes names unique per folder (same basename in two
# directories -> two profiles) and dodges reserved names like 'test'.
# The hash is over the *physical* (symlink-resolved) path, so launching
# through a symlink reuses the profile of the real folder.
# Legacy: if a profile with the old plain-basename name already exists
# for this folder, it is kept (no orphaning of earlier installs).
#
# First run in a folder asks to create a profile (config.yaml/.env/SOUL.md
# hardlinked from default) or to run the default profile.
#
# Skills are SHARED: <profile>/skills is a single symlink to
# <default>/skills (same treatment as config.yaml/.env/SOUL.md) — every
# profile sees every skill, always current, no per-profile copy/sync step.
#
# Note: after renaming/moving a project the hash changes, so a new profile
# is offered. Keep the old one by answering 'd' and deleting it by hand.

# Plain files that are the same for every profile, symlinked from the
# default home rather than duplicated. auth.lock rides along with
# auth.json: its path is derived independently (get_hermes_home() /
# "auth.lock"), so leaving it as a real per-profile file would flock a
# different file per profile while writing the same shared auth.json —
# no actual mutual exclusion across profiles. Edit freely.
SHARED_FILES=(
  config.yaml
  .env
  SOUL.md
  auth.json
  auth.lock
  models_dev_cache.json
  models_dev_cache.etag
  provider_models_cache.json
  ollama_cloud_models_cache.json
  tui-theme-boot.json
)

set -euo pipefail

SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -h "$SOURCE" ]; do
  DIR="$(cd -P "$(dirname -- "$SOURCE")" && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SCRIPT_DIR="$(cd -P "$(dirname -- "$SOURCE")" && pwd)"

HERMES_HOME_DIR="${HERMES_HOME:-$HOME/.hermes}"
# Guard: a parent hermes session exports HERMES_HOME, and it points at that
# session's *profile home* (~/.hermes/profiles/<name>), not the profiles
# root. Using it here would create the new profile (via hermes, which
# ignores the env var) at the right place, then hardlink/sync it into
# $HERMES_HOME_DIR/profiles/ → <profile home>/profiles/<new> → fails and
# aborts under set -e. Only a path ending in /profiles is a valid root.
case "$HERMES_HOME_DIR" in
  */profiles) ;;
  */profiles/*) HERMES_HOME_DIR="${HERMES_HOME_DIR%/profiles/*}" ;;
  *) HERMES_HOME_DIR="$HOME/.hermes" ;;
esac
REAL_HERMES="${HERMES_BIN:-$HOME/.local/bin/hermes}"
# All chat launches go through the sbox wrapper (sandboxed: $PWD rw,
# ~/.hermes rw). hermes-sbox is the sibling shim: `aicode hermes "$@"`.
SBOX_HERMES="$SCRIPT_DIR/hermes-sbox"

# Only chat entry points honor the project profile; admin/other subcommands
# (profile, gateway, config, model, sessions, ...) pass through untouched.
# Switch targets: bare `hermes`, flag-first, or the `chat` subcommand.
first="${1-}"
is_chat=0
case "$first" in
  ""|"chat"|"-"*) : ;;                 # switch-profile case
  *) is_chat=1 ;;                       # some other subcommand
esac
if [ "$is_chat" = 1 ]; then
  exec "$SBOX_HERMES" "$@"
fi

create_profile() {
  local name="$1" dflt="$HERMES_HOME_DIR" pdir="$HERMES_HOME_DIR/profiles/$1" f
  # Hardcoded paths: PY and REPO are not exported by the hermes bootstrap.
  local py="$HOME/.hermes/hermes-agent/venv/bin/python"
  local repo="$HOME/.hermes/hermes-agent"
  echo "Creating profile '$name'..."
  "$REAL_HERMES" profile create "$name" --no-alias --no-skills
  # Symlink the shared files from default. Using symlinks (not hardlinks)
  # because hermes rewrites these via atomic replace (tmp + os.replace):
  # a hardlink would be orphaned when the inode is swapped out, breaking
  # all other profiles.  A symlink always resolves to the same path and
  # finds the new file after replacement.
  # if-form (not '[ -f ] && ln'): a missing source would be the last command
  # of the function, returning 1 and tripping set -e mid-creation.
  for f in "${SHARED_FILES[@]}"; do
    if [ -f "$dflt/$f" ]; then
      ln -sf "$dflt/$f" "$pdir/$f"
    fi
  done
  # Skills: symlink the whole folder rather than per-file, shared across
  # all profiles. 'hermes profile create' pre-seeds skills/ as a real
  # directory even with --no-skills; rm it first since ln -s on an
  # existing real directory nests a link inside it instead of replacing it.
  if [ -d "$dflt/skills" ]; then
    rm -rf "$pdir/skills"
    ln -s "$dflt/skills" "$pdir/skills"
  fi
  # Set display_name from the folder basename (strip the -<8hex> hash).
  # Only do this for project profiles (names ending in -<8hex>); skip
  # 'default', 'custom', and legacy plain-basename profiles.
  if [[ $name == *-???????? ]]; then
    local base="${name%-????????}"
    "$py" - "$repo" "$name" "$base" <<'PYEOF'
import sys
sys.path.insert(0, sys.argv[1])
from hermes_cli import profiles  # noqa: E402
profiles.set_profile_display_name(sys.argv[2], sys.argv[3])
PYEOF
  fi
  echo "Profile '$name' ready — memory & sessions isolated, config + skills symlinked from default."
  return 0
}

root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
# Physical path: symlinks to the same repo must map to the same profile.
root="$(cd -P "$root" && pwd)"
cwd="$(pwd)"
# Sanitized basename + 8-hex hash of the physical path.
base="$(basename "$root" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
# If cwd is a subdirectory of the git root, use the subdirectory basename
# instead of the repo root basename, so hermes uses the right profile.
if [ "$cwd" != "$root" ]; then
  base="$(basename "$cwd" | tr '[:upper:]' '[:lower:]' | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//')"
fi
if [ -z "$base" ]; then
  base="p"
fi
hash8="$(printf '%s' "$root" | shasum -a 1 | cut -c1-8)"
# Cap the base so the full name stays within the 64-char profile limit.
base="${base:0:55}"
name="$base-$hash8"
# The -<8hex> suffix guarantees uniqueness per physical path and keeps the
# name clear of reserved words ('test', 'tmp', 'root', ...) — a name like
# 'test-7e28be1c' is not itself reserved and is a valid profile id.
# Legacy: an install that predates the hash naming created a plain
# basename profile for this folder — keep using it instead of orphaning it.
profiles_dir="$HERMES_HOME_DIR/profiles"
if [ -n "$base" ] && [ ! -d "$profiles_dir/$name" ] && [ -d "$profiles_dir/$base" ]; then
  name="$base"
fi

if [ ! -d "$profiles_dir/$name" ]; then
  if [ -t 0 ]; then
    printf 'No Hermes profile for %s\nCreate a "%s" profile? [C]reate / [d]efault / [t]emp: ' "$root" "$name"
    IFS= read -r ans || ans="c"
    case "$ans" in
      d*|D*) exec "$SBOX_HERMES" "$@" ;;
      t*|T*)
        # Temporary profile: unique per launch, removed on exit.
        # No `exec` here: exec would replace this shell (and its trap) with
        # hermes-sbox before it even runs, so cleanup would never fire, and
        # falling out of the case without an explicit exit would drop into
        # the create_profile call below and recreate a folder-named profile.
        tmp_name="tmp-$$-$(head -c4 /dev/urandom | shasum -a 1 | cut -c1-8)"
        create_profile "$tmp_name"
        trap 'rm -rf "$profiles_dir/$tmp_name" 2>/dev/null' EXIT
        set +e
        "$SBOX_HERMES" -p "$tmp_name" "$@"
        rc=$?
        set -e
        exit "$rc"
        ;;
    esac
  fi
  create_profile "$name"
fi

# Migrate profiles from an earlier hermes version (per-skill hardlinks or
# symlinks, real per-profile copies of SHARED_FILES) to the shared
# symlinks. Cheap no-op once migrated.
if [ -d "$HERMES_HOME_DIR/skills" ] && [ ! -L "$profiles_dir/$name/skills" ]; then
  rm -rf "$profiles_dir/$name/skills"
  ln -s "$HERMES_HOME_DIR/skills" "$profiles_dir/$name/skills"
fi
for f in "${SHARED_FILES[@]}"; do
  if [ -f "$HERMES_HOME_DIR/$f" ] && [ ! -L "$profiles_dir/$name/$f" ]; then
    ln -sf "$HERMES_HOME_DIR/$f" "$profiles_dir/$name/$f"
  fi
done

exec "$SBOX_HERMES" -p "$name" "$@"
