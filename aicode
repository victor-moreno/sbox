#!/usr/bin/env bash
# aicode — run a coding assistant inside a sandbox restricted to the current directory.
# Usage: aicode <coder> [args...]
#   coder: claude, hermes, or any command-name on PATH
set -e

if [ $# -lt 1 ]; then
  echo "aicode: usage: aicode <coder> [args...]" >&2
  echo "  coders: claude, hermes, ..." >&2
  exit 1
fi

CODER="$1"; shift

# Validate coder name: only allow alphanumeric, hyphens, underscores
if [[ ! "$CODER" =~ ^[a-zA-Z0-9_-]+$ ]]; then
  echo "aicode: invalid coder name '$CODER' (use only letters, digits, -, _)" >&2
  exit 1
fi

# -sl / --slurm (any position): enable slurm/munge access for this launch,
# overriding ENABLE_SLURM in paths.conf.
# -local (any position): run claude against a model served on localhost.
# Both are stripped so the coder never sees them.
ARGS=()
for _a in "$@"; do
  case "$_a" in
    -sl|--slurm) export SBOX_SLURM=1 ;;
    -local|--local) SBOX_LOCAL=1 ;;
    *) ARGS+=("$_a") ;;
  esac
done
set -- "${ARGS[@]+"${ARGS[@]}"}"

# sbox is claude's sandbox: turn off claude's own per-command Bash sandbox
# (sandbox.enabled in the shared ~/.claude/settings.json, which the desktop app
# also uses). Nesting Seatbelt fails with "sandbox_apply: Operation not
# permitted" on macOS. --settings outranks user settings, so the desktop app
# keeps its sandbox.
if [[ "$CODER" == "claude" ]]; then
  set -- --settings '{"sandbox":{"enabled":false}}' "$@"
fi

# -local must be resolved before either exec below, so it also applies when
# aicode is re-entered from inside a sandbox shell.
if [ -n "${SBOX_LOCAL:-}" ]; then
  source "$(cd "$(dirname -- "${BASH_SOURCE[0]:-$0}")" && pwd -P)/lib/local-llm.sh"
fi

# already inside a sandbox shell — just run the coder directly
if [ -n "$SANDBOX_DIR" ]; then
  exec command "$CODER" "$@"
fi

SBOX_ROOT="$(cd "$(dirname -- "${BASH_SOURCE[0]:-$0}")" && pwd -P)"
export SBOX_ROOT

case "$(uname -s)" in
  Darwin) exec "$SBOX_ROOT/lib/macos.sh" "$CODER" "$@" ;;
  Linux)  exec "$SBOX_ROOT/lib/linux.sh" "$CODER" "$@" ;;
  *)      echo "aicode: unsupported platform: $(uname -s)" >&2; exit 1 ;;
esac
