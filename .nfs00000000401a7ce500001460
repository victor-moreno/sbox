# paths.conf — paths exposed inside the sandbox.
#
# Edit RW/RO arrays to add or remove paths. $HOME and other env vars are
# expanded. Files vs. directories are auto-detected. Nonexistent paths are
# silently skipped, so it's fine to list things only one of your machines has.
#
# Always exposed (handled by the platform scripts, not configurable here):
#   - $PWD (the project directory): full read+write
#   - system dirs (/usr, /etc, /opt, homebrew on macOS, conda on Linux): RO

# Read+write inside sandbox (applies to all coders)
RW=(
  "/tmp"
  "$HOME/.cache"
  "$HOME/.config"
  "$HOME/.npm"
  "$HOME/R"
  "$HOME/.local/share/claude/versions/" # claude update
  "$HOME/.local/state/claude/"
  "$HOME/ondemand/data/sys/dashboard"   # link ondemand dev folder
  "$HOME/app"
)

# Shared resources: RW, but opt-in per-project instead of global.
# a symlink that points partway these paths is writable
SHARED_RW=(
  "$HOME/app/STAMP"
  "$HOME/ondemand/dev/"
  "$HOME/prj/apuntesBE-med1"	# submodulos
  "$HOME/prj/TTS"
)

# Read-only inside sandbox (applies to all coders)
RO=(
  "$HOME/.local"
  "$HOME/.claude/CLAUDE.md"
  "$HOME/.claudeUB/CLAUDE.md"
  "$HOME/.gitconfig"
  "$HOME/.gitignore_global"
  "$HOME/.Rprofile"
  "/scratch"
  "/shared/projects/AI/ollama/models"
  "/shared/projects/AI/huggingface"
  "/shared/projects/AI/models/tts"
  "/share"                      # Linux cluster software (skipped elsewhere)
)

# Coder-specific RW paths, keyed by CODER_RW_<codername> variables.
# Paths are newline-delimited to support spaces in paths.
# Nonexistent paths are skipped.
# For any coder not listed here, ~/.<coder> and ~/.<coder>.json are tried.
CODER_RW_CLAUDE="$(printf '%s\n%s\n' "$HOME/.claude" "$HOME/.claude.json" "$HOME/.claudeUB")"
CODER_RW_HERMES="$HOME/.hermes"


# Per-project isolation: coders whose conversation history is isolated per project.
# Linux only (bind-mounts). macOS ignores this: claude already namespaces history
# per folder, and isolating its config dir there forked one OAuth token per
# project, which forced a /login in every new folder (see lib/macos.sh).
CODER_PROJECT_ISOLATION="claude"

# Slurm/munge access inside the sandbox (Linux only). When 1, sbatch/squeue/
# etc. can reach /run/slurm/conf and the munge auth socket, so job submission
# works the same as outside the sandbox. Set to 0 to block it: sbatch is still
# on PATH (it's just /usr/bin/sbatch) but has no config/auth to submit with.

ENABLE_SLURM=0

# GPU access inside the sandbox (Linux only). When 1, the host's /dev/nvidia*
# devices, a read-only /sys/module and a /dev/shm tmpfs are bound in, so CUDA
# works; CUDA_VISIBLE_DEVICES is forwarded either way. Set to 0 to hide the
# GPUs (nvidia-smi and torch.cuda then report no driver/devices). Ignored on
# hosts without NVIDIA devices.
ENABLE_GPU=1

# Entries prepended to PATH inside the sandboxed shell, in order.
PATH_EXTRA=(
  "$HOME/.local/bin"
  "$HOME/bin"
  "$HOME/.local/python3/bin"
)

SSH_AUTH_SOCK=

# Network filter. 1: the sandbox reaches the internet only through
# lib/netproxy.py (HTTP(S)_PROXY), which allows the hosts below and asks
# about any other one in a dialog (Deny / Allow for this session / Always
# allow). "Always" answers go to net-allow.conf next to this file; edit it
# freely, it is re-read live. Both files are read-only inside the sandbox.
# Patterns: "host" exact, "*.host" subdomains, "!pattern" deny without asking.
# HTTPS is not decrypted: allowing a host allows any traffic to it.
# macOS: direct connections other than localhost are blocked by Seatbelt.
# Linux: the sandbox gets its own network namespace, except with slurm
# enabled (slurmctld needs direct TCP), where the filter is advisory only.
# Tools that ignore HTTP(S)_PROXY get no network. 0 disables all of this.
NET_FILTER=1
NET_ALLOW=(
  "*.anthropic.com" "claude.ai" "*.claude.ai" "claude.com" "*.claude.com"
  "github.com" "*.github.com" "*.githubusercontent.com" "*.github.io" "ghcr.io"
  "git.iconcologia.net"
  "pypi.org" "files.pythonhosted.org" "registry.npmjs.org"
  "*.r-project.org" "bioconductor.org" "*.bioconductor.org" "*.r-universe.dev"
  "packagemanager.posit.co"
  "huggingface.co" "*.huggingface.co" "*.hf.co"
  "api.telegram.org"

  # claude-code telemetry (Datadog logs): deny silently, no dialog
  "!*.datadoghq.com"
)

DISABLE_TELEMETRY=1
DISABLE_ERROR_REPORTING=1
CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC=1

