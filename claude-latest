#!/usr/bin/env bash
# Launcher for ~/.local/bin/claude — always execs the newest installed build.
#
# The native installer normally repoints ~/.local/bin/claude on update, but the
# in-sandbox updater can't: paths.conf binds versions/ read-write so downloads
# succeed, while ~/.local/bin stays read-only, and replacing a symlink needs
# write permission on the containing directory. Result: versions pile up and the
# symlink stays pinned to whatever was current when sbox was first set up.
# Resolving at exec time sidesteps the write entirely.
#
# Install (from outside the sandbox, where ~/.local/bin is writable):
#   install -m 755 ~/bin/sbox/claude-latest ~/.local/bin/claude
set -e

D="$HOME/.local/share/claude/versions"

# Ignore anything that isn't a plain X.Y.Z build, so a partially-downloaded
# temp file can't win the sort. sort -V so 2.1.9 < 2.1.278 (lexical gets this wrong).
V="$(ls -1 "$D" 2>/dev/null | grep -E '^[0-9]+\.[0-9]+\.[0-9]+$' | sort -V | tail -1)"

if [ -z "$V" ]; then
  echo "claude: no installed version found in $D" >&2
  exit 1
fi

exec "$D/$V" "$@"
